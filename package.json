{
  "name": "orbitopl-toolbox",
  "version": "1.4.0",
  "description": "A modern, cross-platform way to manage your OPL game collection. ",
  "author": "Luden",
  "license": "GPL-3.0-only",
  "main": "dist/src/main.js",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "setup": "node scripts/setup.js",
    "postinstall": "electron-builder install-app-deps",
    "commit": "cz commit",
    "electron": "electron",
    "start": "npm run build:info && npm run build && electron ./dist/src/main.js",
    "build": "tsc",
    "build:watch": "tsc -w",
    "build:info": "node scripts/generate-build-info.js",
    "angular:serve": "cd angular && npx ng serve",
    "electron:serve": "electron ./dist/src/main.js --serve",
    "app:serve": "npm run build:info && concurrently \"npm run angular:serve\" \"npm run build:watch\" \"wait-on http://localhost:4200 && npm run electron:serve\"",
    "remove": "rimraf -rf ./dist && rimraf -rf ./build",
    "package:prep": "npm run remove && npm run build:info && cd angular && npm run build --omit=dev && cd .. && npm run build",
    "package:win": "npm run package:prep && electron-builder --win",
    "package:mac": "npm run package:prep && electron-builder --mac",
    "package:linux": "npm run package:prep && node scripts/patch-fpm-rpm.js && PATH=\"$(brew --prefix binutils 2>/dev/null)/bin:$PATH\" electron-builder --linux && node scripts/patch-fpm-rpm.js",
    "package:all": "npm run package:prep && node scripts/patch-fpm-rpm.js && PATH=\"$(brew --prefix binutils 2>/dev/null)/bin:$PATH\" electron-builder --win --mac --linux && node scripts/patch-fpm-rpm.js && node scripts/collect-distributables.js"
  },
  "dependencies": {
    "electron-reloader": "^1.2.3",
    "lz4js": "^0.2.0"
  },
  "devDependencies": {
    "7zip-bin": "^5.2.0",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.4",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.7",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "wait-on": "^8.0.5"
  },
  "overrides": {
    "extract-zip": {
      "yauzl": "^3.0.0"
    }
  },
  "build": {
    "productName": "OrbitOPLToolbox",
    "files": [
      "dist/**/*",
      "package.json",
      "assets"
    ],
    "directories": {
      "output": "build"
    },
    "afterAllArtifactBuild": "./scripts/rename-linux-zip.js",
    "win": {
      "icon": "assets/applogo/icon_256x256.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "assets/applogo/icon_512x512.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "maintainer": "Luden02 <47905649+Luden02@users.noreply.github.com>",
      "vendor": "Luden02"
    }
  }
}
